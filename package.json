{
  "name": "tg-web",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram Web clone — React + TypeScript + Socket.IO",
  "repository": {
    "type": "git",
    "url": "git@github.com:hotokens/tg-web-analog.git"
  },
  "homepage": "https://github.com/hotokens/tg-web-analog#readme",
  "bugs": {
    "url": "https://github.com/hotokens/tg-web-analog/issues"
  },
  "keywords": [
    "telegram",
    "messenger",
    "chat",
    "react",
    "typescript",
    "socket.io",
    "sqlite",
    "vite"
  ],
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
